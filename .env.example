# Application connection. Use a NON-superuser role so row-level security applies.
DATABASE_URL=postgres://resourceos_app:change-me@localhost:5432/resourceos

# Privileged connection used only by db/migrate.mjs and db/seed.mjs.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/resourceos

# Absolute origin used in links (optional).
APP_URL=http://localhost:3000

# Seals provider credentials for integrations (32 bytes, hex or base64).
# Generate with: openssl rand -hex 32
# Required only when creating an integration connection that stores secrets.
INTEGRATION_ENCRYPTION_KEY=
